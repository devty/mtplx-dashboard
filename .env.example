# Copy to .env and export into your shell, or pass inline:
#   RAPID_MLX_TARGETS='qwen=http://box.local:8000:8010' npm run dev
# This project does not read .env automatically (no dotenv dependency) —
# keeping the dependency list minimal. Use your shell/direnv, or Node's
# native `--env-file=.env` flag if you want file-based env loading:
#   node --env-file=.env dist/server.js

# rapid-mlx inference servers. Comma-separated list of id=<url>[:<proxyPort>][|label]
# Default: qwen=http://127.0.0.1:8000:8010
RAPID_MLX_TARGETS=qwen=http://127.0.0.1:8000:8010

# Port this dashboard server listens on
PORT=8123

# How often to poll rapid-mlx's Prometheus endpoint
POLL_INTERVAL_MS=1000

# Timeout for each poll request (scrape budget; separate from forward timeout)
SCRAPE_TIMEOUT_MS=2500

# Depth of the server-side sparkline history ring buffers (dashboard)
RING_SIZE=120

# Depth of the server-side live-log rolling buffer
LOG_BUFFER_SIZE=300

# Ceiling for poll-retry backoff when rapid-mlx is unreachable
MAX_BACKOFF_MS=10000

# SQLite stats persistence
DB_PATH=data/history.db
PERSIST_ENABLED=1
RETENTION_DAYS=30

# How long to retain transcript/request body rows (days)
TRANSCRIPT_RETENTION_DAYS=7

# Prune interval for expired history rows
PRUNE_INTERVAL_MS=3600000

# Health/run detection poll interval
HEALTH_INTERVAL_MS=5000

# Gauge persistence interval (much slower than scrape; see Task 7)
GAUGE_PERSIST_INTERVAL_MS=10000

# --- Dream health page (public/dream.html) -----------------------------------
# gbrain's append-only nightly-dream log. The page is a read-only parser over it.
GBRAIN_LOG_PATH=~/.gbrain/dream-nightly.log

# The brain repo, used ONLY for a read-only `git log` cross-check of which
# nights actually banked a commit. Unset/unreadable yields "couldn't check",
# which the page shows as distinct from "no commit".
GBRAIN_BRAIN_DIR=~/mybrain

# The LaunchAgent plist the dream schedule is read from. Without a readable
# schedule, missed-night detection disables itself rather than assuming an hour.
GBRAIN_DREAM_PLIST=~/Library/LaunchAgents/com.gbrain.dream-nightly.plist
